# ─── KREW environment variables ───────────────────────────────────────────
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real values. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of this site, no trailing slash.
#   Local:       http://localhost:3000
#   Production:  https://your-project.vercel.app  (later: https://your-custom-domain.com)
# Preview deployments use their own Vercel URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: show "Continue with Apple" (only after enabling Apple in Supabase Auth).
NEXT_PUBLIC_ENABLE_APPLE_SIGNIN=false
